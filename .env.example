# คัดลอกเป็น .env.local แล้วกรอกค่าจริง
# copy: .env.example → .env.local
# อย่า commit ไฟล์ที่มีค่าจริง

# ---------- Postgres (Neon / Supabase pooled URL) ----------
# ใช้ connection pooler เช่น
# postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/dailyApp?sslmode=require
#
# หรือ Postgres local จาก docker compose ในโฟลเดอร์นี้ (พอร์ต 5433 เพื่อไม่ชนของเดิม):
#   docker compose up -d db
#   npm run db:push
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dailyApp

# ---------- JWT (HS256 — ไม่ใช้ไฟล์ PEM) ----------
# สร้างเองอย่างน้อย 32 ตัว เช่น openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=dailyapp
JWT_AUDIENCE=dailyapp-web

# ---------- Google ----------
# OAuth 2.0 Web client ID (ไม่ใช่ Android / iOS)
# Google Cloud Console → Credentials → Create credentials → OAuth client ID → Web application
#   Authorized JavaScript origins = http://localhost:3000 (และโดเมน Vercel)
#   Authorized redirect URIs = http://localhost:3000/login/google (และ https://โดเมน/login/google)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Places API (New) + Routes API ฝั่ง server — Autocomplete, Place Details, ระยะทางขับรถ
# Google Cloud Console → APIs & Services → Library เปิด "Places API (New)" และ "Routes API"
# ใช้ API key ชุดเดียวกับ Maps ก็ได้ ถ้าเปิด Places + Routes บนคีย์นั้นแล้ว
GOOGLE_API_KEY=
# ชื่อสำรองที่โค้ดอ่านถ้ายังไม่มี GOOGLE_API_KEY
GOOGLE_API_KEY_MAP=

# Longdo Map Search — แปลงชื่อสถานที่เป็น lat/lon (เก็บที่ server อย่างเดียว)
# https://map.longdo.com/api
LONGDO_API_KEY=

# ---------- Auth0 passwordless OTP (ชุดเดียวกับ Personservice) ----------
# Domain ไม่ต้องใส่ https:// เช่น xxx.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# true = ยังไม่ต่อ Auth0 ก็ส่ง/ตรวจ OTP ได้ (ห้ามเปิดบน production)
# รหัส dev ถูก log ที่ terminal ของ next dev
AUTH_DEV_OTP=true
NEXT_PUBLIC_AUTH_DEV_OTP=true
